diff --git a/chrome/appmode.inc b/chrome/appmode.inc
new file mode 100644
index 0000000..3198e7e
--- /dev/null
+++ b/chrome/appmode.inc
@@ -0,0 +1,222 @@
+/* appmode.inc - app (kiosk) mode: asb-chromed serves ONE web app instead of a browser, e.g. AmiDiscord
+   (ASB_APP=amidiscord, https://discord.com/app). Included by host.c after audio.inc. Nothing here runs unless
+   ASB_APP is set, so AmiSurf's own sessions behave exactly as before.
+
+   Environment (set by the AmiStudio Host's service block):
+     ASB_APP            app id; turns app mode on
+     ASB_APP_URL        start URL (loaded at start and on "cmd app home")
+     ASB_APP_ALLOW      comma/space list of host globs that may load in the page ("*.discord.com", "discord.gg",
+                        "127.0.0.1:8080" with a port); everything else is external
+     ASB_APP_EXTERNAL   client (default): external links are cancelled and sent to the client as OPENURL;
+                        deny: just cancelled
+     ASB_APP_TITLE      title sent in META until the page has one
+     ASB_APP_REDUCEDMOTION  1 (default) or 0: prefers-reduced-motion + frame throttling (cmd app reducedmotion 0|1)
+     ASB_APP_SMALL_MS / ASB_APP_BIG_MS  throttle: at most one update per SMALL_MS (default 100), and changes that
+                        cover more than a quarter of the view at most once per BIG_MS (default 1000)
+     ASB_APP_DARK       1: also emulate prefers-color-scheme: dark
+     ASB_APP_MUTE       1 (default): Chrome runs with --mute-audio, so the app's own sounds never play (the client
+                        plays its own notification sounds)
+   In app mode there are no tabs, no asb:// pages, no bookmarks/history/suggestions, no password manager and no
+   save page/source/PDF. Client NAV is accepted for allowlisted hosts only. */
+
+static char g_app_id[64], g_app_url[1200], g_app_title[128];
+#define APP_MAXALLOW 48
+static char g_app_allow[APP_MAXALLOW][128]; static int g_app_nallow;
+static int g_app_ext;                     /* 0 client (OPENURL), 1 deny */
+static int g_rm=1, g_rm_small_ms=100, g_rm_big_ms=1000, g_app_dark, g_app_mute=1;
+static int g_app_fetch_on;                /* Fetch.enable done on this tab */
+static void app_bws_open(void);
+
+static const char *APP_DEFAULT_ALLOW="discord.com,*.discord.com,discordapp.com,*.discordapp.com,*.discordapp.net,"
+  "discord.gg,*.discord.gg,discord.new,*.hcaptcha.com,hcaptcha.com";
+
+static int env_int(const char *n,int def){ const char *v=getenv(n); return v&&v[0]?atoi(v):def; }
+static void app_init(void){
+  const char *a=getenv("ASB_APP"); if(!a||!a[0]) return;
+  g_app=1; scopy(g_app_id,sizeof g_app_id,a);
+  const char *u=getenv("ASB_APP_URL"); scopy(g_app_url,sizeof g_app_url,u&&u[0]?u:"https://discord.com/app");
+  const char *t=getenv("ASB_APP_TITLE"); scopy(g_app_title,sizeof g_app_title,t&&t[0]?t:a);
+  const char *x=getenv("ASB_APP_EXTERNAL"); g_app_ext=x&&!strcasecmp(x,"deny");
+  const char *al=getenv("ASB_APP_ALLOW"); if(!al||!al[0]) al=APP_DEFAULT_ALLOW;
+  char tmp[4096]; scopy(tmp,sizeof tmp,al);
+  for(char *s=strtok(tmp,", \t");s && g_app_nallow<APP_MAXALLOW;s=strtok(NULL,", \t")){
+    for(char *q=s;*q;q++) *q=(char)tolower((unsigned char)*q);
+    scopy(g_app_allow[g_app_nallow++],sizeof g_app_allow[0],s); }
+  g_rm=env_int("ASB_APP_REDUCEDMOTION",1)!=0;
+  g_rm_small_ms=env_int("ASB_APP_SMALL_MS",100); g_rm_big_ms=env_int("ASB_APP_BIG_MS",1000);
+  g_app_dark=env_int("ASB_APP_DARK",0)!=0; g_app_mute=env_int("ASB_APP_MUTE",1)!=0;
+  scopy(g_title,sizeof g_title,g_app_title);
+  fprintf(stderr,"asb-chromed: app mode '%s': %s, %d allowed host patterns, external links %s, reduced motion %s%s\n",
+    g_app_id,g_app_url,g_app_nallow,g_app_ext?"denied":"to the client",g_rm?"on":"off",g_app_mute?", muted":""); }
+
+/* "https://user@Host.Example:443/x" -> host "host.example", port 443 (0 if none); returns 0 if not http(s) */
+static int url_host(const char *url,char *host,int cap,int *port){
+  const char *p; *port=0; host[0]=0;
+  if(!strncasecmp(url,"https://",8)) p=url+8; else if(!strncasecmp(url,"http://",7)) p=url+7; else return 0;
+  const char *e=p+strcspn(p,"/?#"); const char *at=memchr(p,'@',(size_t)(e-p)); if(at) p=at+1;
+  int n=0; for(;p<e && *p!=':' && n<cap-1;p++) host[n++]=(char)tolower((unsigned char)*p); host[n]=0;
+  if(p<e && *p==':') *port=atoi(p+1);
+  return n>0; }
+static int glob_host(const char *pat,const char *host){
+  if(pat[0]=='*' && pat[1]=='.'){ size_t pl=strlen(pat+1), hl=strlen(host);   /* "*.x.com": any subdomain of x.com */
+    return hl>pl && !strcmp(host+hl-pl,pat+1); }
+  return !strcmp(pat,host); }
+static int app_url_ok(const char *url){
+  if(!strcmp(url,"about:blank")) return 1;
+  char h[256]; int port; if(!url_host(url,h,sizeof h,&port)) return 0;
+  char hp[280]; snprintf(hp,sizeof hp,"%s:%d",h,port);
+  for(int i=0;i<g_app_nallow;i++){ const char *pat=g_app_allow[i];
+    if(strchr(pat,':')){ if(port && glob_host(pat,hp)) return 1; } else if(glob_host(pat,h)) return 1; }
+  return 0; }
+
+static void put_str16(unsigned char *b,int *o,int cap,const char *s){
+  unsigned n=(unsigned)strlen(s); if((int)n>cap-*o-2) n=(unsigned)(cap-*o-2); if((int)n<0) n=0;
+  asbc_put_u16(b+*o,n); *o+=2; memcpy(b+*o,s,n); *o+=(int)n; }
+/* an external link: reason 0 link/navigation, 1 new window, 2 typed by the client */
+static void app_openurl(const char *url,int reason){
+  fprintf(stderr,"asb-chromed: app: external %s %.200s\n",reason==1?"window":reason==2?"address from the client":"link",url);
+  if(g_app_ext || g_cli<0) return;
+  unsigned char b[2600]; int o=0; put_str16(b,&o,(int)sizeof b-1,url); b[o++]=(unsigned char)reason;
+  asbc_send(g_cli,ASBC_OPENURL,b,(uint32_t)o); }
+
+/* ---- per tab: emulation + navigation guard ---- */
+static void app_media(void){
+  int i=cdp_id();
+  cdp("{\"id\":%d,\"method\":\"Emulation.setEmulatedMedia\",\"params\":{\"features\":[{\"name\":\"prefers-reduced-motion\",\"value\":\"%s\"}%s]}}",
+      i,g_rm?"reduce":"",g_app_dark?",{\"name\":\"prefers-color-scheme\",\"value\":\"dark\"}":""); }
+static void app_enable(void){
+  if(!g_app || g_bidi) return;
+  app_media();
+  /* top-level documents are checked before they load (Fetch, request stage, documents only) */
+  int i=cdp_id(); cdp("{\"id\":%d,\"method\":\"Fetch.enable\",\"params\":{\"patterns\":[{\"urlPattern\":\"*\",\"resourceType\":\"Document\",\"requestStage\":\"Request\"}]}}",i);
+  g_app_fetch_on=1;
+  app_bws_open(); }
+
+/* ---- new windows: window.open / target=_blank ----
+   A second CDP connection to the browser endpoint auto-attaches to every new page with waitForDebuggerOnStart, so
+   a popup is paused before it loads anything. Its first document request is caught with Fetch in the popup's own
+   session: the window is closed again, never having contacted the site, and the URL opens in the app's page
+   (allowlisted host) or goes to the client as OPENURL. */
+static int g_bws=-1; static long long g_bws_retry;
+static struct { char sid[80], tid[80]; long long t; } g_pop[8]; static int g_npop;
+static int bcdp(const char *fmt,...){
+  static char cmd[4000]; va_list ap; va_start(ap,fmt); vsnprintf(cmd,sizeof cmd,fmt,ap); va_end(ap);
+  return g_bws>=0?ws_send_text(g_bws,cmd):-1; }
+static const char *main_target(void){ return (g_tab>=0 && g_tab<g_ntab)?g_tabs[g_tab].id:""; }
+static void app_bws_open(void){
+  if(!g_app || g_bidi || g_bws>=0) return;
+  buf_t r={0}; char u[400]="";
+  if(!http_get(g_dbg,"/json/version",&r) && r.p) json_str(r.p,"webSocketDebuggerUrl",u,sizeof u);
+  free(r.p);
+  if(!u[0] || (g_bws=ws_open(u))<0){ g_bws=-1; fprintf(stderr,"asb-chromed: app: browser endpoint not reachable, new windows are not caught\n"); return; }
+  bcdp("{\"id\":%d,\"method\":\"Target.setAutoAttach\",\"params\":{\"autoAttach\":true,\"waitForDebuggerOnStart\":true,\"flatten\":true,\"filter\":[{\"type\":\"page\",\"exclude\":false}]}}",cdp_id()); }
+static void app_bws_close(void){ if(g_bws>=0){ close(g_bws); g_bws=-1; } g_npop=0; }
+static void pop_drop(int k){ g_pop[k]=g_pop[--g_npop]; }
+static void app_bws_msg(const char *msg){
+  char method[80]=""; json_str(msg,"method",method,sizeof method);
+  if(!strcmp(method,"Target.attachedToTarget")){
+    char sid[80]="", tid[80]=""; json_str(msg,"sessionId",sid,sizeof sid); json_str(msg,"targetId",tid,sizeof tid);
+    if(strstr(msg,"\"openerId\"") && strcmp(tid,main_target()) && g_npop<8){   /* a window the page opened */
+      scopy(g_pop[g_npop].sid,sizeof g_pop[0].sid,sid); scopy(g_pop[g_npop].tid,sizeof g_pop[0].tid,tid); g_pop[g_npop].t=now_ms(); g_npop++;
+      bcdp("{\"id\":%d,\"sessionId\":\"%s\",\"method\":\"Fetch.enable\",\"params\":{\"patterns\":[{\"urlPattern\":\"*\",\"resourceType\":\"Document\",\"requestStage\":\"Request\"}]}}",cdp_id(),sid); }
+    bcdp("{\"id\":%d,\"sessionId\":\"%s\",\"method\":\"Runtime.runIfWaitingForDebugger\"}",cdp_id(),sid);
+    return; }
+  if(!strcmp(method,"Fetch.requestPaused")){
+    char sid[80]="", rid[120]="", url[2400]="";
+    { const char *q=NULL, *f=msg; while((f=strstr(f,"\"sessionId\":\""))){ q=f; f++; } if(q) json_str(q,"sessionId",sid,sizeof sid); }   /* the top-level (last) one */
+    json_str(msg,"requestId",rid,sizeof rid); { const char *r=strstr(msg,"\"request\""); json_str(r?r:msg,"url",url,sizeof url); }
+    bcdp("{\"id\":%d,\"sessionId\":\"%s\",\"method\":\"Fetch.failRequest\",\"params\":{\"requestId\":\"%s\",\"errorReason\":\"Aborted\"}}",cdp_id(),sid,rid);
+    for(int k=0;k<g_npop;k++) if(!strcmp(g_pop[k].sid,sid)){
+      bcdp("{\"id\":%d,\"method\":\"Target.closeTarget\",\"params\":{\"targetId\":\"%s\"}}",cdp_id(),g_pop[k].tid); pop_drop(k);
+      if(app_url_ok(url)){ fprintf(stderr,"asb-chromed: app: new window for %.200s opened in the page instead\n",url); cdp_nav(url); }
+      else app_openurl(url,1);
+      break; }
+    return; }
+  if(!strcmp(method,"Target.detachedFromTarget")){ char sid[80]=""; json_str(msg,"sessionId",sid,sizeof sid);
+    for(int k=0;k<g_npop;k++) if(!strcmp(g_pop[k].sid,sid)){ pop_drop(k); break; } } }
+
+/* ---- reduced motion: frame throttling ----
+   Animated pages (Discord's login background) otherwise resend near-full frames several times a second: 2.2 MB
+   each at 1024x720 RGB24. Updates come at most every SMALL_MS; large ones (> 1/4 of the view changed) at most every
+   BIG_MS. A held frame is replaced by newer ones and goes out when it is due, so the last state always arrives. */
+static unsigned char *g_hold; static int g_hold_w, g_hold_h; static long long g_last_upd, g_last_big;
+static long dirty_area(const unsigned char *rgb,int iw,int ih){
+  if(!g_prev || g_prev_w!=iw || g_prev_h!=ih) return (long)iw*ih;
+  int st=iw*3, minx=iw, maxx=-1, miny=-1, maxy=-1;
+  for(int y=0;y<ih;y++){ const unsigned char *a=rgb+(long)y*st, *b=g_prev+(long)y*st;
+    if(!memcmp(a,b,(size_t)st)) continue;
+    if(miny<0) miny=y; maxy=y;
+    int x0=0; while(x0<iw && !memcmp(a+x0*3,b+x0*3,3)) x0++;
+    int x1=iw-1; while(x1>x0 && !memcmp(a+x1*3,b+x1*3,3)) x1--;
+    if(x0<minx) minx=x0; if(x1>maxx) maxx=x1; }
+  return maxx<0?0:(long)(maxx-minx+1)*(maxy-miny+1); }
+static void frame_rgb(unsigned char *rgb,int iw,int ih,int n);
+/* returns 1 if the frame was kept for later (the caller must not use rgb any more) */
+static int app_hold(unsigned char *rgb,int iw,int ih){
+  if(!g_app || !g_rm) return 0;
+  long long t=now_ms(); long a=dirty_area(rgb,iw,ih);
+  if(!a){ free(rgb); return 1; }                                   /* nothing changed */
+  int big=a*4>(long)iw*ih;
+  if(t-g_last_upd>=g_rm_small_ms && (!big || t-g_last_big>=g_rm_big_ms) && !g_hold){
+    g_last_upd=t; if(big) g_last_big=t; return 0; }
+  free(g_hold); g_hold=rgb; g_hold_w=iw; g_hold_h=ih; return 1; }
+static void app_hold_flush(void){
+  if(!g_hold) return;
+  if(g_cli<0 || !g_screencast_on){ free(g_hold); g_hold=NULL; return; }
+  long long t=now_ms(); if(t-g_last_upd<g_rm_small_ms) return;
+  long a=dirty_area(g_hold,g_hold_w,g_hold_h); int big=a*4>(long)g_hold_w*g_hold_h;
+  if(big && t-g_last_big<g_rm_big_ms) return;
+  unsigned char *r=g_hold; g_hold=NULL; g_last_upd=t; if(big) g_last_big=t;
+  if(!a){ free(r); return; }
+  frame_rgb(r,g_hold_w,g_hold_h,0); }
+static void app_set_rm(int on){
+  g_rm=on!=0; if(!g_rm && g_hold){ unsigned char *r=g_hold; g_hold=NULL; frame_rgb(r,g_hold_w,g_hold_h,0); }
+  app_media(); fprintf(stderr,"asb-chromed: app: reduced motion %s\n",g_rm?"on":"off");
+  send_status(g_rm?"Reduced motion on":"Reduced motion off"); }
+
+/* ---- client commands in app mode: "app home|reducedmotion 0|1", zoom, find, ctx, avdelay; the rest is ignored ---- */
+static int app_cmd(char *c,char *arg){
+  if(!g_app) return 0;
+  if(!strcmp(c,"zoom")||!strcmp(c,"findnext")||!strcmp(c,"findprev")||!strcmp(c,"findclose")||!strcmp(c,"ctx")||!strcmp(c,"avdelay")) return 0;
+  if(!strcmp(c,"home")){ cdp_nav(g_app_url); return 1; }
+  if(!strcmp(c,"app")){
+    char *v=strchr(arg,' '); if(v) *v++=0; else v="";
+    if(!strcmp(arg,"home")) cdp_nav(g_app_url);
+    else if(!strcmp(arg,"reducedmotion")) app_set_rm(atoi(v));
+    else fprintf(stderr,"asb-chromed: app: unknown command app %s\n",arg);
+    return 1; }
+  fprintf(stderr,"asb-chromed: app mode: cmd %s ignored\n",c); return 1; }
+/* client NAV in app mode: allowlisted hosts only */
+static int app_nav(const char *u){
+  if(!g_app) return 0;
+  if(app_url_ok(u)) cdp_nav(u);
+  else { fprintf(stderr,"asb-chromed: app: NAV to %.200s refused (not on ASB_APP_ALLOW)\n",u); send_status("That address does not open here"); app_openurl(u,2); }
+  return 1; }
+
+/* CDP events/replies for app mode; returns 1 if consumed */
+static int app_event(const char *method,const char *msg){
+  if(!g_app) return 0;
+  if(!strcmp(method,"Fetch.requestPaused")){
+    char rid[120]="", fid[80]="", url[2400]=""; json_str(msg,"requestId",rid,sizeof rid); json_str(msg,"frameId",fid,sizeof fid);
+    { const char *r=strstr(msg,"\"request\""); json_str(r?r:msg,"url",url,sizeof url); }
+    int i=cdp_id();
+    if(!strcmp(fid,main_target()) && !app_url_ok(url)){
+      cdp("{\"id\":%d,\"method\":\"Fetch.failRequest\",\"params\":{\"requestId\":\"%s\",\"errorReason\":\"Aborted\"}}",i,rid);
+      app_openurl(url,0); }
+    else cdp("{\"id\":%d,\"method\":\"Fetch.continueRequest\",\"params\":{\"requestId\":\"%s\"}}",i,rid);
+    return 1; }
+  return 0; }
+
+/* every main-loop pass (20 ms) */
+static void app_tick(void){
+  if(!g_app) return;
+  app_hold_flush();
+  long long t=now_ms();
+  for(int k=0;k<g_npop;k++) if(t-g_pop[k].t>8000){ fprintf(stderr,"asb-chromed: app: empty new window closed\n");
+    bcdp("{\"id\":%d,\"method\":\"Target.closeTarget\",\"params\":{\"targetId\":\"%s\"}}",cdp_id(),g_pop[k].tid); pop_drop(k); k--; }
+  if(g_bws<0 && g_ws>=0 && !g_bidi && t>g_bws_retry){ g_bws_retry=t+5000; app_bws_open(); } }
+/* the browser endpoint's messages (select loop in host.c) */
+static void app_bws_read(void){
+  static buf_t b; int k=ws_recv(g_bws,&b);
+  if(k<0){ fprintf(stderr,"asb-chromed: app: browser endpoint closed\n"); app_bws_close(); return; }
+  if(k>0 && b.n) app_bws_msg(b.p); }
diff --git a/chrome/asbc.h b/chrome/asbc.h
index 2f90e61..25cdbdb 100644
--- a/chrome/asbc.h
+++ b/chrome/asbc.h
@@ -53,7 +53,9 @@ enum {
   ASBC_AUDIO  = 44, /* u8 fmt (ASBC_AU_*), u8 channels, u16 rate, u32 host ms timestamp, u16 nframes, data */
   ASBC_BMARKS = 45, /* 0.87, host -> client: utf-8 lines "url\ttitle\tfolder" (bookmarks.tsv order); sent after the
                        client's "bookmarks" cmd and again whenever the list changes. Older clients never ask. */
-  ASBC_SCROLL = 43  /* u16 x,y,w,h, i16 dy: move that page area by dy (content moves up when dy<0) */
+  ASBC_SCROLL = 43, /* u16 x,y,w,h, i16 dy: move that page area by dy (content moves up when dy<0) */
+  /* app mode (ASB_APP, appmode.inc); AmiSurf sessions never get these */
+  ASBC_OPENURL= 48  /* u16 n, url, u8 reason (0 link, 1 new window, 2 client NAV not allowed): open it outside the app */
 };
 
 /* FRAME fmt 3 payload (after the 12 header bytes and fmt=3): u8 pixfmt (ASBC_PF_*, the format announced with ASBC_FMT),
diff --git a/chrome/features.inc b/chrome/features.inc
index 351c733..45b0ec4 100644

+/* returns 1 if the op was an app-mode op (ignored outside app mode, as before) */
+static int app_client_op(int op,const unsigned char *p,int n){
+  if(op!=ASBC_CAPS && op!=ASBC_FOCUS && op!=ASBC_NOTIFYACT && op!=ASBC_FILEPUT) return 0;

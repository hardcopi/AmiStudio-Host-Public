diff --git a/chrome/appproto.inc b/chrome/appproto.inc
new file mode 100644
index 0000000..92d2d02
--- /dev/null
+++ b/chrome/appproto.inc
@@ -0,0 +1,168 @@
+/* appproto.inc - app mode (ASB_APP) client protocol: CAPS/APPINFO, FOCUS, NOTIFY/NOTIFYCLOSE/NOTIFYACT, UNREAD,
+   OPENURL gating, FILEREQ/FILEPUT/FILEDONE (uploads) and DOWNLOAD. Included from appnotify.inc.
+   Op numbers and payloads: asbc.h. A message type goes to the client only if the client set its bit with ASBC_CAPS
+   (sent after FMT); the Host answers CAPS with APPINFO. AmiSurf never sends CAPS: nothing changes for it, and
+   asb-chromed outside app mode ignores the new client ops.
+   Environment: ASB_APP_MAXUPLOAD  upload limit in MB (default 25)
+                ASB_UPLOADS        where uploads are kept for the page (default <ASB_CONFIG>/uploads; engine.sh:
+                                   <ASB_STATE>/uploads); files are deleted 10 minutes after they were handed over */
+
+#define APP_HOSTCAPS (ASBC_CAP_NOTIFY|ASBC_CAP_UNREAD|ASBC_CAP_FOCUS|ASBC_CAP_OPENURL|ASBC_CAP_FILE|ASBC_CAP_DOWNLOAD)
+static uint32_t g_app_caps;   /* what this client negotiated (0 until CAPS) */
+
+static void put_u32(unsigned char *b,int *o,uint32_t v){ b[*o]=(unsigned char)v; b[*o+1]=(unsigned char)(v>>8); b[*o+2]=(unsigned char)(v>>16); b[*o+3]=(unsigned char)(v>>24); *o+=4; }
+static uint32_t get_u32(const unsigned char *p){ return (uint32_t)p[0]|((uint32_t)p[1]<<8)|((uint32_t)p[2]<<16)|((uint32_t)p[3]<<24); }
+static int app_can(uint32_t cap){ return g_app && g_cli>=0 && (g_app_caps&cap); }
+/* str with a byte limit that does not cut a UTF-8 sequence */
+static void put_s16(unsigned char *b,int *o,int cap,const char *s,int lim){
+  int n=(int)strlen(s); if(n>lim){ n=lim; while(n>0 && ((unsigned char)s[n]&0xC0)==0x80) n--; }
+  if(n>cap-*o-2) n=cap-*o-2; if(n<0) n=0;
+  asbc_put_u16(b+*o,(unsigned)n); *o+=2; memcpy(b+*o,s,(size_t)n); *o+=n; }
+
+/* ---- outputs used by appnotify.inc / appmode.inc ---- */
+static void app_notify_out(uint32_t id,int kind,const char *title,const char *body,const char *tag,const char *hint,const char *url,int iw,int ih,const unsigned char *rgb){
+  if(!app_can(ASBC_CAP_NOTIFY)) return;
+  static unsigned char b[8192+64*64*3]; int o=0, cap=(int)sizeof b-64*64*3-8;
+  put_u32(b,&o,id); b[o++]=(unsigned char)kind;
+  put_s16(b,&o,cap,title,300); put_s16(b,&o,cap,body,2000); put_s16(b,&o,cap,tag,200); put_s16(b,&o,cap,hint,200); put_s16(b,&o,cap,url,1200);
+  if(iw>0 && ih>0){ b[o++]=1; asbc_put_u16(b+o,(unsigned)iw); asbc_put_u16(b+o+2,(unsigned)ih); o+=4; memcpy(b+o,rgb,(size_t)iw*ih*3); o+=iw*ih*3; }
+  else b[o++]=0;
+  asbc_send(g_cli,ASBC_NOTIFY,b,(uint32_t)o); }
+static void app_notifyclose_out(uint32_t id){
+  if(!app_can(ASBC_CAP_NOTIFY)) return;
+  unsigned char b[4]; int o=0; put_u32(b,&o,id); asbc_send(g_cli,ASBC_NOTIFYCLOSE,b,4); }
+static void app_unread_out(int count,int mentions,int flags){
+  if(!app_can(ASBC_CAP_UNREAD)) return;
+  unsigned char b[5]; asbc_put_u16(b,(unsigned)count); asbc_put_u16(b+2,(unsigned)mentions); b[4]=(unsigned char)flags;
+  asbc_send(g_cli,ASBC_UNREAD,b,5); }
+
+/* ---- downloads: kept in ASB_DOWNLOADS under their own name; DOWNLOAD tells the client where ---- */
+static void app_dl_behavior(void){   /* Chrome saves as <guid>; renamed on completion, so the reported path is exact */
+  if(!g_app || g_bidi) return;
+  char e[1100]; jsonesc(g_dlpath[0]?g_dlpath:"/tmp",e,sizeof e);
+  cdp("{\"id\":%d,\"method\":\"Browser.setDownloadBehavior\",\"params\":{\"behavior\":\"allowAndName\",\"downloadPath\":\"%s\",\"eventsEnabled\":true}}",cdp_id(),e); }
+static void app_safe_name(const char *in,char *out,int cap){
+  int n=0; for(;*in && n<cap-1;in++){ unsigned char c=(unsigned char)*in;
+    out[n++]=(c<32||c=='/'||c=='\\'||c==':'||c=='"'||c=='*'||c=='?'||c=='<'||c=='>'||c=='|')?'_':(char)c; }
+  out[n]=0; while(n>0 && (out[n-1]==' '||out[n-1]=='.')) out[--n]=0;
+  if(!out[0] || !strcmp(out,".") || !strcmp(out,"..")) scopy(out,cap,"download"); }
+static void app_download(const char *guid,const char *name,int state,double size){
+  if(!g_app) return;
+  char path[1400]=""; char nm[256]; app_safe_name(name,nm,sizeof nm);
+  if(state==1 && guid[0]){
+    const char *dir=g_dlpath[0]?g_dlpath:"/tmp"; char from[1000]; snprintf(from,sizeof from,"%s/%s",dir,guid);
+    char base[256], ext[64]=""; scopy(base,sizeof base,nm); char *dot=strrchr(base,'.'); if(dot && dot!=base && strlen(dot)<sizeof ext){ scopy(ext,sizeof ext,dot); *dot=0; }
+    struct stat st;
+    for(int k=0;k<1000;k++){
+      if(k) snprintf(path,sizeof path,"%s/%s (%d)%s",dir,base,k,ext); else snprintf(path,sizeof path,"%s/%s%s",dir,base,ext);
+      if(stat(path,&st)) break; }
+    if(rename(from,path)){ fprintf(stderr,"asb-chromed: app: download %s: rename failed: %s\n",nm,strerror(errno)); scopy(path,sizeof path,from); }
+    { const char *sl=strrchr(path,'/'); scopy(nm,sizeof nm,sl?sl+1:path); } }
+  fprintf(stderr,"asb-chromed: app: download %s %s%s%s\n",state==0?"started":state==1?"done":"failed",nm,path[0]?" -> ":"",path);
+  if(!app_can(ASBC_CAP_DOWNLOAD)) return;
+  unsigned char b[2000]; int o=0; b[o++]=(unsigned char)state; put_s16(b,&o,(int)sizeof b,nm,250);
+  put_u32(b,&o,size>0&&size<4294967295.0?(uint32_t)size:0); put_s16(b,&o,(int)sizeof b,path,1400);
+  asbc_send(g_cli,ASBC_DOWNLOAD,b,(uint32_t)o); }
+
+/* ---- uploads: the page's file chooser becomes FILEREQ; the client streams FILEPUT; DOM.setFileInputFiles ---- */
+static struct { uint32_t req; int open, multiple, backend, desc_id, nf; char accept[300]; char files[8][800];
+  FILE *f; long long got, size, sum; } g_up;
+static uint32_t g_up_seq;
+static struct { char path[800]; long long t; } g_upkeep[32]; static int g_nupkeep;
+static char g_updir[700];
+static long long app_maxupload(void){ return (long long)env_int("ASB_APP_MAXUPLOAD",25)*1024*1024; }
+static void app_filedone(uint32_t req,int status,const char *msg){
+  fprintf(stderr,"asb-chromed: app: upload %u: %s\n",req,msg);
+  if(!app_can(ASBC_CAP_FILE)) return;
+  unsigned char b[400]; int o=0; put_u32(b,&o,req); b[o++]=(unsigned char)status; put_s16(b,&o,(int)sizeof b,msg,300);
+  asbc_send(g_cli,ASBC_FILEDONE,b,(uint32_t)o); }
+static void up_unlink(const char *path){   /* the file and its own folder */
+  unlink(path); char d[800]; scopy(d,sizeof d,path); char *sl=strrchr(d,'/'); if(sl){ *sl=0; rmdir(d); } }
+static void up_abort(void){
+  if(g_up.f){ fclose(g_up.f); g_up.f=NULL; }
+  for(int i=0;i<g_up.nf;i++) up_unlink(g_up.files[i]);
+  g_up.nf=0; g_up.open=0; }
+static void app_intercept_files(int on){
+  cdp("{\"id\":%d,\"method\":\"Page.setInterceptFileChooserDialog\",\"params\":{\"enabled\":%s}}",cdp_id(),on?"true":"false"); }
+static void app_filereq_send(void){
+  if(!app_can(ASBC_CAP_FILE)){ g_up.open=0; return; }
+  unsigned char b[400]; int o=0; put_u32(b,&o,g_up.req); b[o++]=(unsigned char)(g_up.multiple?1:0); put_s16(b,&o,(int)sizeof b,g_up.accept,300);
+  asbc_send(g_cli,ASBC_FILEREQ,b,(uint32_t)o);
+  fprintf(stderr,"asb-chromed: app: file chooser -> FILEREQ %u (%s, accept \"%s\")\n",g_up.req,g_up.multiple?"multiple":"single",g_up.accept); }
+static int app_file_event(const char *method,const char *msg){
+  if(!strcmp(method,"Page.fileChooserOpened")){
+    if(g_up.open) up_abort();
+    char mode[40]=""; json_str(msg,"mode",mode,sizeof mode);
+    memset(&g_up,0,sizeof g_up); g_up.req=++g_up_seq; g_up.open=1; g_up.multiple=!strcmp(mode,"selectMultiple");
+    g_up.backend=json_int(msg,"backendNodeId",0);
+    g_up.desc_id=cdp_id(); cdp("{\"id\":%d,\"method\":\"DOM.describeNode\",\"params\":{\"backendNodeId\":%d}}",g_up.desc_id,g_up.backend);
+    return 1; }
+  if(!method[0] && g_up.desc_id && json_int(msg,"id",-1)==g_up.desc_id){   /* attributes: [.., "accept", "image/png", ..] */
+    g_up.desc_id=0;
+    const char *a=strstr(msg,"\"attributes\":["); if(a){ a+=14;
+      for(int k=0;k<64 && *a && *a!=']';k++){ char v[300]; const char *q=ja_next(a,v,(int)sizeof v); if(q==a) break; a=q;
+        if(!(k&1) && !strcmp(v,"accept")){ ja_next(a,g_up.accept,(int)sizeof g_up.accept); break; } } }
+    app_filereq_send(); return 1; }
+  return 0; }
+static void app_fileput(const unsigned char *p,int n){
+  if(n<11) return;
+  uint32_t req=get_u32(p); int flags=p[4]; unsigned nl=asbc_get_u16(p+5);
+  if(n<7+(int)nl+4) return;
+  char name[256]; int k=(int)nl<255?(int)nl:255; memcpy(name,p+7,(size_t)k); name[k]=0;
+  uint32_t size=get_u32(p+7+nl); const unsigned char *d=p+11+nl; int dn=n-11-(int)nl;
+  if(!g_up.open || req!=g_up.req){ app_filedone(req,2,"no such file request"); return; }
+  if(flags&2){ up_abort(); app_filedone(req,2,"cancelled"); return; }
+  if(nl){   /* a new file */
+    if(g_up.f){ fclose(g_up.f); g_up.f=NULL; }
+    if(g_up.nf==8 || (g_up.nf && !g_up.multiple)){ up_abort(); app_filedone(req,2,"too many files"); return; }
+    g_up.sum+=size;
+    if((long long)size>app_maxupload() || g_up.sum>app_maxupload()){ char m[120]; snprintf(m,sizeof m,"too big (limit %lld MB)",app_maxupload()/1048576);
+      up_abort(); app_filedone(req,1,m); return; }
+    char sn[256]; app_safe_name(name,sn,sizeof sn); mkdir(g_updir,0700);
+    char sub[600]; snprintf(sub,sizeof sub,"%.500s/%u-%d",g_updir,req,g_up.nf); mkdir(sub,0700);   /* own folder: the page sees the real name */
+    snprintf(g_up.files[g_up.nf],sizeof g_up.files[0],"%.500s/%.200s",sub,sn);
+    int fd=open(g_up.files[g_up.nf],O_WRONLY|O_CREAT|O_TRUNC,0600); g_up.f=fd>=0?fdopen(fd,"wb"):NULL;
+    if(!g_up.f){ up_abort(); app_filedone(req,2,"cannot write the upload on the Host"); return; }
+    g_up.nf++; g_up.got=0; g_up.size=size; }
+  if(!g_up.f && dn>0){ up_abort(); app_filedone(req,2,"data before a file name"); return; }
+  if(dn>0){ if(g_up.got+dn>g_up.size || fwrite(d,1,(size_t)dn,g_up.f)!=(size_t)dn){ up_abort(); app_filedone(req,2,"more data than announced"); return; } g_up.got+=dn; }
+  if(!(flags&1)) return;
+  if(g_up.f){ fclose(g_up.f); g_up.f=NULL; }
+  if(g_up.got!=g_up.size){ up_abort(); app_filedone(req,2,"file incomplete"); return; }

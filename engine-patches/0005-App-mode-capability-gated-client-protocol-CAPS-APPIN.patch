+  if(op==ASBC_NOTIFYACT){ if(n>=5 && (g_app_caps&ASBC_CAP_NOTIFY)) app_notify_act(get_u32(p),p[4]); return 1; }
+  if(op==ASBC_FILEPUT){ if(g_app_caps&ASBC_CAP_FILE) app_fileput(p,n); return 1; }

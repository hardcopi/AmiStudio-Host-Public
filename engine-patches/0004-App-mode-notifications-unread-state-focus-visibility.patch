index 0000000..b8f2746
--- /dev/null
+++ b/chrome/appnotify.inc
@@ -0,0 +1,276 @@
+/* appnotify.inc - app mode (ASB_APP) notifications, unread state and focus/visibility, for AmiDiscord.
+   Included by host.c after appmode.inc; nothing runs unless ASB_APP is set.
+
+   Sources (no DOM scraping):
+   - the Notification API: a small preload script (Page.addScriptToEvaluateOnNewDocument, main world, allowlisted
+     origins only) replaces window.Notification and ServiceWorkerRegistration.showNotification with a shim that
+     reports to the "asbNotify" binding; notification permission is granted up front for the app's origins;
+   - the main frame's <title> and favicon <link> (the page's own metadata, watched by a MutationObserver on <head>):
+     Discord puts "(N) " (N = mentions + unread DMs) or a "• " (unread without mention) in front of its title, and
+     swaps the favicon when it has unread mentions.
+   Binding: random name per run, added again on every Page.frameNavigated (no Runtime.enable); the shim takes it off
+   window at once and prefixes every message with the per-run key, so other frames cannot fake notifications.
+   The shim reports JSON arrays (after the key): ["hello",top,origin], ["show",id,title,body,tag,url,icon], ["close",id],
+   ["meta",title,favicon href]; icon = "WxH:" + base64 RGB24 (<= 64x64, on white) or "".
+   The Host talks back with a CustomEvent whose name is a random per-run key: ["focus",f,v], ["click",id],
+   ["dismiss",id].
+
+   Focus/visibility: Discord only notifies when its window is not focused or hidden. app_focus(f,v) makes the page
+   believe it (Emulation.setFocusEmulationEnabled, document.hasFocus / visibilityState / hidden, focus, blur and
+   visibilitychange events). visible=0 also stops the screencast: no frames go out while the client's window is
+   iconified, but the page keeps running, so notifications and unread changes keep coming. With no client the page
+   is unfocused and hidden (so Discord notifies and does not mark messages read); a new client starts focused and
+   visible until it says otherwise ("cmd app focus F V", ASBC_FOCUS). */
+
+static const char APP_SHIM[] =
+  "(function(){\n"
+  "var K=\"@KEY@\", BN=\"@BIND@\", A=@ALLOW@, B=null, Q=[], tries=0;\n"
+  "function grab(){ var f=window[BN]; if(typeof f===\"function\"){ try{ delete window[BN]; }catch(e){} if(!B){ B=f; while(Q.length){ try{ B(Q.shift()); }catch(e){} } } } return !!B; }\n"
+  "(function w(){ if(!grab() && tries++<500) setTimeout(w,20); })();\n"
+  "var h=location.hostname.toLowerCase(), pt=location.port, hp=h+\":\"+pt;\n"
+  "function g(p,x){ return p.slice(0,2)===\"*.\"?(x.length>p.length-1&&x.slice(1-p.length)===p.slice(1)):p===x; }\n"
+  "if(!A.some(function(p){ return p.indexOf(\":\")>=0?(pt&&g(p,hp)):g(p,h); })) return;\n"
+  "function post(a){ var s=JSON.stringify([K].concat(a)); if(grab()){ try{ B(s); }catch(e){} } else if(Q.length<50) Q.push(s); }\n"
+  "var top=window===window.top, base=(Math.random()*1e9)|0, seq=0, live={}, F=null, V=null;\n"
+  "function fire(n,t){ var e=new Event(t,{cancelable:true}), f=n[\"on\"+t]; if(typeof f===\"function\"){ try{ f.call(n,e); }catch(x){} } n.dispatchEvent(e); return e.defaultPrevented; }\n"
+  "function icon(u,cb){\n"
+  "  if(!u){ cb(\"\"); return; }\n"
+  "  var done=0, i=new Image(), t=setTimeout(function(){ if(!done){ done=1; cb(\"\"); } },1500);\n"
+  "  i.crossOrigin=\"anonymous\";\n"
+  "  i.onload=function(){ if(done) return; done=1; clearTimeout(t);\n"
+  "    try{ var m=Math.max(i.naturalWidth,i.naturalHeight)||1, s=Math.min(64,m)/m, w=Math.max(1,Math.round(i.naturalWidth*s)), hh=Math.max(1,Math.round(i.naturalHeight*s));\n"
+  "      var c=document.createElement(\"canvas\"); c.width=w; c.height=hh; var x=c.getContext(\"2d\"); x.fillStyle=\"#fff\"; x.fillRect(0,0,w,hh); x.drawImage(i,0,0,w,hh);\n"
+  "      var d=x.getImageData(0,0,w,hh).data, r=[]; for(var k=0;k<d.length;k+=4) r.push(String.fromCharCode(d[k],d[k+1],d[k+2]));\n"
+  "      cb(w+\"x\"+hh+\":\"+btoa(r.join(\"\"))); }catch(e){ cb(\"\"); } };\n"
+  "  i.onerror=function(){ if(!done){ done=1; clearTimeout(t); cb(\"\"); } };\n"
+  "  i.src=u; }\n"
+  "class Notification extends EventTarget{\n"
+  "  constructor(t,o){ super(); if(t===undefined) throw new TypeError(\"Failed to construct 'Notification': 1 argument required, but only 0 present.\");\n"
+  "    o=o||{}; var id=base+(++seq), me=this, url=\"\";\n"
+  "    this.title=String(t); this.body=o.body?String(o.body):\"\"; this.tag=o.tag?String(o.tag):\"\"; this.icon=o.icon?String(o.icon):\"\";\n"
+  "    this.data=o.data===undefined?null:o.data; this.silent=!!o.silent; this.requireInteraction=!!o.requireInteraction;\n"
+  "    this.lang=o.lang||\"\"; this.dir=o.dir||\"auto\"; this.badge=o.badge||\"\"; this.image=o.image||\"\"; this.renotify=!!o.renotify; this.timestamp=Date.now(); this.actions=[];\n"
+  "    this.onclick=this.onclose=this.onshow=this.onerror=null;\n"
+  "    Object.defineProperty(this,\"_asb\",{value:id});\n"
+  "    if(this.tag) for(var k in live){ if(live[k].tag===this.tag){ var old=live[k]; delete live[k]; post([\"close\",+k]); fire(old,\"close\"); } }\n"
+  "    live[id]=this;\n"
+  "    try{ var d=o.data; if(d&&typeof d===\"object\"&&typeof d.url===\"string\") url=d.url; }catch(e){}\n"
+  "    icon(this.icon,function(ic){ if(!live[id]) return; post([\"show\",id,me.title,me.body,me.tag,url,ic]); setTimeout(function(){ fire(me,\"show\"); },0); }); }\n"
+  "  close(){ var id=this._asb; if(live[id]){ delete live[id]; post([\"close\",id]); fire(this,\"close\"); } }\n"
+  "  static get permission(){ return \"granted\"; }\n"
+  "  static requestPermission(cb){ if(typeof cb===\"function\"){ try{ cb(\"granted\"); }catch(e){} } return Promise.resolve(\"granted\"); }\n"
+  "  static get maxActions(){ return 0; }\n"
+  "}\n"
+  "window.Notification=Notification;\n"
+  "if(window.ServiceWorkerRegistration){ var P=ServiceWorkerRegistration.prototype;\n"
+  "  P.showNotification=function(t,o){ new Notification(t,o); return Promise.resolve(); };\n"
+  "  P.getNotifications=function(){ return Promise.resolve(Object.keys(live).map(function(k){ return live[k]; })); }; }\n"
+  "var D=Document.prototype, hf=D.hasFocus;\n"
+  "function getter(n){ var d=Object.getOwnPropertyDescriptor(D,n); return d&&d.get; }\n"
+  "var gv=getter(\"visibilityState\"), gh=getter(\"hidden\"), patched=0;\n"
+  "function patch(){ if(patched) return; patched=1;\n"
+  "  D.hasFocus=function hasFocus(){ return F===null?hf.call(this):F; };\n"
+  "  if(gv) Object.defineProperty(D,\"visibilityState\",{get:function(){ return V===null?gv.call(this):(V?\"visible\":\"hidden\"); },configurable:true,enumerable:true});\n"
+  "  if(gh) Object.defineProperty(D,\"hidden\",{get:function(){ return V===null?gh.call(this):!V; },configurable:true,enumerable:true}); }\n"
+  "function state(f,v){\n"
+  "  var of=F===null?true:F, ov=V===null?true:V;\n"
+  "  patch();\n"
+  "  F=!!f; V=!!v;\n"
+  "  if(ov!==V) document.dispatchEvent(new Event(\"visibilitychange\"));\n"
+  "  if(of!==F) window.dispatchEvent(new Event(F?\"focus\":\"blur\")); }\n"
+  "window.addEventListener(K,function(e){ e.stopImmediatePropagation(); var d=e.detail||[];\n"
+  "  if(d[0]===\"focus\") state(d[1],d[2]);\n"
+  "  else if(d[0]===\"click\"||d[0]===\"dismiss\"){ var n=live[d[1]]; if(!n) return;\n"
+  "    if(d[0]===\"click\") fire(n,\"click\"); else { delete live[d[1]]; fire(n,\"close\"); } } },true);\n"
+  "post([\"hello\",top?1:0,location.origin]);\n"
+  "if(top){ var lt=null, li=null, q=0;\n"
+  "  function meta(){ q=0; var t=document.title, l=document.querySelector(\"link[rel~=icon]\"), u=l?l.href:\"\";\n"
+  "    if(t!==lt||u!==li){ lt=t; li=u; post([\"meta\",t,u]); } }\n"
+  "  function watch(){ meta(); new MutationObserver(function(ms){\n"
+  "      for(var k=0;k<ms.length;k++){ var n=ms[k].target; if(n.nodeType===3) n=n.parentNode;\n"
+  "        if(n===document.head||(n&&(n.nodeName===\"TITLE\"||n.nodeName===\"LINK\"))){ if(!q){ q=1; setTimeout(meta,100); } return; } } })\n"
+  "    .observe(document.head,{childList:true,subtree:true,characterData:true,attributes:true,attributeFilter:[\"href\",\"rel\"]}); }\n"
+  "  if(document.head) watch(); else document.addEventListener(\"DOMContentLoaded\",watch); }\n"
+  "})();\n";
+
+/* title prefixes, tried repeatedly at the start of the title: count = "(N) ", dot = "• " (also without the space).
+   Kept as data: Discord's exact format may change. */
+static const struct { const char *pfx; int kind; } APP_TITLE_PAT[] = {
+  { "(%u) ", 1 }, { "(%u)", 1 }, { "\xE2\x80\xA2 ", 2 }, { "\xE2\x80\xA2", 2 }, { NULL, 0 } };
+
+static char g_app_key[40], g_app_bind[24];   /* random per run: the Host->shim event name (also the shim's token), binding name */
+static int g_app_foc=1;                 /* g_app_vis (host.c) is the visible flag */
+static int g_app_unread[3], g_app_unread_sent[3]={-1,-1,-1};   /* count, mentions, flags (1 dot, 2 favicon badge) */
+static long long g_app_unread_t;
+static char g_app_icon0[600], g_app_iconcur[600];   /* first favicon of the document (the plain one), current one */
+static int g_app_nlogged;
+
+#define APP_NTF 32
+typedef struct { uint32_t id; long long shim; int kind; char tag[128]; } app_ntf;
+static app_ntf g_ntf[APP_NTF]; static int g_nntf; static uint32_t g_ntf_next=1;
+
+static void app_notify_out(uint32_t id,int kind,const char *title,const char *body,const char *tag,const char *hint,const char *url,int iw,int ih,const unsigned char *rgb);
+static void app_notifyclose_out(uint32_t id);
+static void app_unread_out(int count,int mentions,int flags);
+
+static void jsonesc(const char *s,char *o,int cap){   /* JSON string body (no quotes) */
+  int n=0; for(;*s && n<cap-7;s++){ unsigned char c=(unsigned char)*s;
+    if(c=='\\'||c=='"'){ o[n++]='\\'; o[n++]=(char)c; }
+    else if(c=='\n'){ o[n++]='\\'; o[n++]='n'; }
+    else if(c<32){ n+=snprintf(o+n,(size_t)(cap-n),"\\u%04x",c); }
+    else o[n++]=(char)c; }
+  o[n]=0; }
+
+static void app_shim_install(void){
+  if(!g_app || g_bidi) return;
+  if(g_cli<0){ g_app_foc=0; g_app_vis=0; }   /* nobody is looking: unfocused and hidden */
+  if(!g_app_key[0]){ unsigned char r[12]; if(RAND_bytes(r,12)!=1) for(int i=0;i<12;i++) r[i]=(unsigned char)rng32();
+    strcpy(g_app_key,"asb"); for(int i=0;i<12;i++) snprintf(g_app_key+3+i*2,3,"%02x",r[i]);
+    if(RAND_bytes(r,8)!=1) for(int i=0;i<8;i++) r[i]=(unsigned char)rng32();
+    strcpy(g_app_bind,"_"); for(int i=0;i<8;i++) snprintf(g_app_bind+1+i*2,3,"%02x",r[i]); }
+  char allow[APP_MAXALLOW*140]; int o=0; allow[o++]='[';
+  for(int i=0;i<g_app_nallow;i++) o+=snprintf(allow+o,sizeof allow-(size_t)o,"%s\"%s\"",i?",":"",g_app_allow[i]);
+  allow[o++]=']'; allow[o]=0;
+  static char src[sizeof APP_SHIM+sizeof allow+128];
+  const char *k=strstr(APP_SHIM,"@KEY@"), *bn=strstr(APP_SHIM,"@BIND@"), *a=strstr(APP_SHIM,"@ALLOW@");
+  snprintf(src,sizeof src,"%.*s%s%.*s%s%.*s%s%s",(int)(k-APP_SHIM),APP_SHIM,g_app_key,(int)(bn-k-5),k+5,g_app_bind,(int)(a-bn-6),bn+6,allow,a+7);
+  static char esc[sizeof src*2]; jsonesc(src,esc,sizeof esc);
+  cdp("{\"id\":%d,\"method\":\"Runtime.addBinding\",\"params\":{\"name\":\"%s\"}}",cdp_id(),g_app_bind);
+  cdp("{\"id\":%d,\"method\":\"Page.addScriptToEvaluateOnNewDocument\",\"params\":{\"source\":\"%s\",\"runImmediately\":true}}",cdp_id(),esc); }
+
+/* notification (+ clipboard) permission for the app's origins: the start URL's and every exact allowlisted host */
+static void app_grant(void){
+  if(!g_app || g_bws<0) return;
+  char o[400]; origin_of(g_app_url,o,sizeof o);
+  if(o[0]) bcdp("{\"id\":%d,\"method\":\"Browser.grantPermissions\",\"params\":{\"origin\":\"%s\",\"permissions\":[\"notifications\"]}}",cdp_id(),o);
+  for(int i=0;i<g_app_nallow;i++){ if(strchr(g_app_allow[i],'*')) continue;
+    char e[300]; snprintf(e,sizeof e,"https://%.200s",g_app_allow[i]); if(!strcmp(e,o)) continue;
+    bcdp("{\"id\":%d,\"method\":\"Browser.grantPermissions\",\"params\":{\"origin\":\"%s\",\"permissions\":[\"notifications\"]}}",cdp_id(),e); } }
+
+static void app_to_shim(const char *arr){   /* ["focus",1,0] etc. to every allowlisted frame of the page */
+  if(g_ws<0) return;
+  char js[400], esc[600];
+  snprintf(js,sizeof js,"dispatchEvent(new CustomEvent(\"%s\",{detail:%s}))",g_app_key,arr); jsonesc(js,esc,sizeof esc);
+  cdp("{\"id\":%d,\"method\":\"Runtime.evaluate\",\"params\":{\"expression\":\"%s\"}}",cdp_id(),esc); }
+
+static void app_focus(int f,int v){
+  if(!g_app) return;
+  f=f!=0; v=v!=0; int was_v=g_app_vis;
+  g_app_foc=f; g_app_vis=v;
+  cdp("{\"id\":%d,\"method\":\"Emulation.setFocusEmulationEnabled\",\"params\":{\"enabled\":%s}}",cdp_id(),f?"true":"false");
+  char a[40]; snprintf(a,sizeof a,"[\"focus\",%d,%d]",f,v); app_to_shim(a);
+  if(was_v && !v){ if(g_screencast_on) cdp_screencast(0); free(g_hold); g_hold=NULL; }
+  if(!was_v && v && g_cli>=0){ cdp_screencast(1); kick_arm(); }
+  fprintf(stderr,"asb-chromed: app: focus %d visible %d%s\n",f,v,!v?" (no frames; notifications continue)":""); }
+
+/* sequential reader for the shim's JSON arrays */
+static const char *ja_next(const char *p,char *out,int cap){
+  while(*p==' '||*p==','||*p=='[') p++;
+  if(*p=='"'){ char tmp[8]; (void)tmp; int n=0; p++;
+    while(*p && *p!='"'){ char c=*p++;
+      if(c=='\\' && *p){ c=*p++;
+        if(c=='n') c='\n'; else if(c=='t') c='\t'; else if(c=='r') c='\r'; else if(c=='b'||c=='f') c=' ';
+        else if(c=='u' && p[0]&&p[1]&&p[2]&&p[3]){ char h[5]={p[0],p[1],p[2],p[3],0}; unsigned cp=(unsigned)strtoul(h,NULL,16); p+=4;
+          if(cp>=0xD800&&cp<0xDC00&&p[0]=='\\'&&p[1]=='u'){ char l[5]={p[2],p[3],p[4],p[5],0}; unsigned lo=(unsigned)strtoul(l,NULL,16);
+            if(lo>=0xDC00&&lo<0xE000){ cp=0x10000+((cp-0xD800)<<10)+(lo-0xDC00); p+=6; } }
+          unsigned char u[4]; int k=0;
+          if(cp<0x80) u[k++]=(unsigned char)cp;
+          else if(cp<0x800){ u[k++]=(unsigned char)(0xC0|cp>>6); u[k++]=(unsigned char)(0x80|(cp&63)); }
+          else if(cp<0x10000){ u[k++]=(unsigned char)(0xE0|cp>>12); u[k++]=(unsigned char)(0x80|(cp>>6&63)); u[k++]=(unsigned char)(0x80|(cp&63)); }
+          else { u[k++]=(unsigned char)(0xF0|cp>>18); u[k++]=(unsigned char)(0x80|(cp>>12&63)); u[k++]=(unsigned char)(0x80|(cp>>6&63)); u[k++]=(unsigned char)(0x80|(cp&63)); }
+          if(n+k<cap) { memcpy(out+n,u,(size_t)k); n+=k; } continue; } }
+      if(n<cap-1) out[n++]=c; }
+    if(*p=='"') p++; out[n]=0; return p; }
+  int n=0; while(*p && *p!=',' && *p!=']' && n<cap-1) out[n++]=*p++; out[n]=0; return p; }

+/* "(3) • Discord | #general" -> count 3, dot */
+static void app_title_unread(const char *t,int *count,int *dot){
+  *count=0; *dot=0;
+  for(int again=1;again;){ again=0;
+    while(*t==' ') t++;
+    for(int i=0;APP_TITLE_PAT[i].pfx;i++){ const char *pf=APP_TITLE_PAT[i].pfx;
+      if(APP_TITLE_PAT[i].kind==1){ unsigned v; int used=0; char fmt[16]; snprintf(fmt,sizeof fmt,"%s%%n",pf);
+        if(sscanf(t,fmt,&v,&used)==1 && used>0 && t[used-1]==pf[strlen(pf)-1]){ *count=(int)(v>65535?65535:v); t+=used; again=1; break; } }
+      else { size_t l=strlen(pf); if(!strncmp(t,pf,l)){ *dot=1; t+=l; again=1; break; } } } } }
+
+static void app_unread_update(const char *title){
+  int c,d; app_title_unread(title,&c,&d);
+  int badge=g_app_icon0[0] && g_app_iconcur[0] && strcmp(g_app_icon0,g_app_iconcur);
+  g_app_unread[0]=c; g_app_unread[1]=c; g_app_unread[2]=(d?1:0)|(badge?2:0); }
+
+/* sends a changed unread state at most twice a second (main loop), and the latest one on reconnect */
+static void app_unread_tick(void){
+  if(!memcmp(g_app_unread,g_app_unread_sent,sizeof g_app_unread) || now_ms()-g_app_unread_t<500) return;
+  memcpy(g_app_unread_sent,g_app_unread,sizeof g_app_unread); g_app_unread_t=now_ms();
+  fprintf(stderr,"asb-chromed: app: unread %d mentions %d flags %d\n",g_app_unread[0],g_app_unread[1],g_app_unread[2]);
+  app_unread_out(g_app_unread[0],g_app_unread[1],g_app_unread[2]); }
+
+static int ntf_find_shim(long long s){ for(int i=0;i<g_nntf;i++) if(g_ntf[i].shim==s) return i; return -1; }
+static int ntf_find(uint32_t id){ for(int i=0;i<g_nntf;i++) if(g_ntf[i].id==id) return i; return -1; }
+static void ntf_drop(int i){ g_ntf[i]=g_ntf[--g_nntf]; }
+
+/* kind 0 channel message, 1 mention, 2 DM, 3 call, 255 other; hint = "#channel, Server" from "user (#channel, Server)" */
+static int app_kind(const char *title,const char *body,char *hint,int cap){
+  hint[0]=0;
+  const char *o=strstr(title," (#"); const char *e=o?strrchr(o,')'):NULL;
+  if(o && e && e>o+2){ int n=(int)(e-(o+2)); if(n>cap-1) n=cap-1; memcpy(hint,o+2,(size_t)n); hint[n]=0; }
+  if(strcasestr(body,"incoming call")||strcasestr(title,"incoming call")||strcasestr(body,"is calling")) return 3;
+  if(o) return strstr(body,"@")?1:0;
+  return title[0]?2:255; }
+
+static void app_shim_msg(const char *pl){
+  static char a[9][16384]; const char *p=pl; int n=0;
+  while(*p && *p!=']' && n<9){ p=ja_next(p,a[n],(int)sizeof a[0]); n++; while(*p==' ') p++; if(*p!=',' && *p!=']') break; }
+  if(n<2 || strcmp(a[0],g_app_key)) return;   /* not from our shim (the binding is visible to the page briefly) */
+  memmove(a[0],a[1],sizeof a[0]*(size_t)(n-1)); n--;   /* drop the token */
+  if(!strcmp(a[0],"hello")){ char s[40]; if(n>=2 && atoi(a[1])){ g_app_icon0[0]=0;   /* new top document: next favicon is the plain one */
+      static char lasto[200]; if(n>=3 && strcmp(lasto,a[2])){ scopy(lasto,sizeof lasto,a[2]); fprintf(stderr,"asb-chromed: app: notification shim active on %.150s\n",a[2]); } } snprintf(s,sizeof s,"[\"focus\",%d,%d]",g_app_foc,g_app_vis); app_to_shim(s); return; }
+  if(!strcmp(a[0],"meta") && n>=3){
+    scopy(g_app_iconcur,sizeof g_app_iconcur,a[2]); if(!g_app_icon0[0]) scopy(g_app_icon0,sizeof g_app_icon0,a[2]);
+    if(strcmp(g_title,a[1]) && a[1][0]){ scopy(g_title,sizeof g_title,a[1]); send_meta(); }
+    app_unread_update(a[1]); return; }
+  if(!strcmp(a[0],"close") && n>=2){ int i=ntf_find_shim(atoll(a[1])); if(i<0) return;
+    uint32_t id=g_ntf[i].id; ntf_drop(i);
+    fprintf(stderr,"asb-chromed: app: notification %u closed by the page\n",id); app_notifyclose_out(id); return; }
+  if(!strcmp(a[0],"show") && n>=7){
+    if(g_nntf==APP_NTF) ntf_drop(0);
+    app_ntf *t=&g_ntf[g_nntf++]; t->id=g_ntf_next++; if(!g_ntf_next) g_ntf_next=1; t->shim=atoll(a[1]); scopy(t->tag,sizeof t->tag,a[4]);
+    char hint[200]; t->kind=app_kind(a[2],a[3],hint,sizeof hint);
+    static unsigned char rgb[64*64*3]; int iw=0, ih=0;
+    if(a[6][0] && sscanf(a[6],"%dx%d:",&iw,&ih)==2 && iw>0 && ih>0 && iw<=64 && ih<=64){
+      const char *b=strchr(a[6],':')+1; if(b64dec(b,(int)strlen(b),rgb,(int)sizeof rgb)!=iw*ih*3) iw=ih=0; }
+    else iw=ih=0;
+    if(g_app_nlogged++<200) fprintf(stderr,"asb-chromed: app: notification %u kind %d \"%.80s\" tag \"%.60s\"%s%s icon %dx%d%s\n",t->id,t->kind,a[2],a[4],
+      hint[0]?" in ":"",hint,iw,ih,g_cli<0?" (no client, dropped)":"");
+    app_notify_out(t->id,t->kind,a[2],a[3],a[4],hint,a[5],iw,ih,rgb); return; } }
+
+/* the client clicked (action 0) or dismissed (1) a notification */
+static void app_notify_act(uint32_t id,int action){
+  int i=ntf_find(id); if(i<0){ fprintf(stderr,"asb-chromed: app: notification %u is gone\n",id); return; }
+  char s[80]; snprintf(s,sizeof s,"[\"%s\",%lld]",action?"dismiss":"click",g_ntf[i].shim);
+  fprintf(stderr,"asb-chromed: app: notification %u %s\n",id,action?"dismissed":"clicked");
+  if(!action){ app_focus(1,1); }   /* the client brings its window to the front */
+  app_to_shim(s); ntf_drop(i); }
+
+static int app_notify_event(const char *method,const char *msg){
+  /* without Runtime.enable (kept off: pages can detect it) a binding only reaches documents that exist when it is
+     added, so it is added again whenever a frame navigates; the shim waits for it */
+  if(!strcmp(method,"Page.frameNavigated")){ cdp("{\"id\":%d,\"method\":\"Runtime.addBinding\",\"params\":{\"name\":\"%s\"}}",cdp_id(),g_app_bind); return 0; }
+  if(!strcmp(method,"Runtime.bindingCalled")){
+    char name[40]=""; json_str(msg,"name",name,sizeof name); if(strcmp(name,g_app_bind)) return 0;
+    static char pl[60000]; if(json_str(msg,"payload",pl,sizeof pl)) app_shim_msg(pl);
+    return 1; }
+  return 0; }
+
+/* app-mode client lifecycle */
+static void app_client_hello(void){   /* before HELLO starts the screencast */
+  if(!g_app) return; g_app_foc=1; g_app_vis=1;
+  cdp("{\"id\":%d,\"method\":\"Emulation.setFocusEmulationEnabled\",\"params\":{\"enabled\":true}}",cdp_id());
+  app_to_shim("[\"focus\",1,1]"); memset(g_app_unread_sent,0xff,sizeof g_app_unread_sent); g_app_unread_t=0; }
+static void app_client_gone(void){ if(!g_app) return; app_focus(0,0); }
+
+/* ---- to the client (M4 sends these as ASBC messages when the client negotiated them with CAPS) ---- */
+static void app_notify_out(uint32_t id,int kind,const char *title,const char *body,const char *tag,const char *hint,const char *url,int iw,int ih,const unsigned char *rgb){
+  (void)id; (void)kind; (void)title; (void)body; (void)tag; (void)hint; (void)url; (void)iw; (void)ih; (void)rgb; }
+static void app_notifyclose_out(uint32_t id){ (void)id; }
+static void app_unread_out(int count,int mentions,int flags){ (void)count; (void)mentions; (void)flags; }
